[Unit]
Description=Galaxy Hub (production — Claude Code / opencode session hub)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/atlas/galaxyhub
Environment=GH_TOKEN_FILE=/opt/atlas/galaxyhub/.token
EnvironmentFile=-/opt/atlas/router-secrets.env
Environment=LITELLM_BASE_URL=http://100.93.16.81:4100/v1
ExecStart=/bin/sh -c '/usr/bin/python3 /opt/atlas/galaxyhub/stardrive.py --bind 127.0.0.1 --port 8877 --token "$(cat ${GH_TOKEN_FILE})"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
